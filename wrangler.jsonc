{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccic-website",
  "account_id": "6793399ef7a68ce167c0923f92b43b90",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "vars": {
    "WIX_SITE_ID": "235e2856-9df4-48ff-ba42-25363a058856",
    "WIX_CLIENT_ID": "39efb562-774e-4ce3-ab40-58d2b9074599"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
